{
  "name": "tally-spec",
  "version": "1.3.1",
  "description": "Single source of truth for TallyPrime schema definitions, TDL contracts, and canonical API routes.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./source.json": "./source.json",
    "./api.json": "./api.json",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "source.json",
    "api.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/keshavsoft/tally-spec.git"
  },
  "keywords": [
    "tally",
    "tally-prime",
    "tdl",
    "tally-spec",
    "contracts",
    "api-contracts",
    "json-driven"
  ],
  "author": "KeshavSoft",
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  }
}